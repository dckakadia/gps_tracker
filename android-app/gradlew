#!/usr/bin/env python3
"""
Fallback script to run Gradle commands when gradlew is not available.
This allows building the Android app using system gradle if installed.
"""

import subprocess
import sys
import os

def run_gradle_command(args):
    """Run a gradle command."""
    cmd = ["gradle"] + args
    try:
        result = subprocess.run(cmd, cwd=os.getcwd())
        sys.exit(result.returncode)
    except FileNotFoundError:
        print("ERROR: Gradle not found in system PATH")
        print("Please install Android Studio from: https://developer.android.com/studio")
        sys.exit(1)

if __name__ == "__main__":
    run_gradle_command(sys.argv[1:])
