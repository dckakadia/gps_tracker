PORT=4000

# PostgreSQL connection string (required for production)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://gps_tracker:YOUR_DB_PASSWORD@localhost:5432/gps_tracker

# Set to false in production (in-memory DB loses all data on restart)
USE_IN_MEMORY_DB=false

# JWT secrets — generate with: openssl rand -base64 48
JWT_SECRET=replace_with_64_char_random_string
REFRESH_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=100y
REFRESH_EXPIRES_IN=100y

# Admin account created on first boot (change before deploying)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin

# Auto-backup via rclone (optional)
ENABLE_AUTO_BACKUP=false
# RCLONE_CONFIG=/home/ubuntu/.config/rclone/rclone.conf
